# INTERNAL_RELEASE_CANDIDATE only；复制到仓库外的受控 Secret 系统，禁止直接使用占位值。
JSH_POS_MYSQL_JDBC_URL=jdbc:mysql://127.0.0.1:3306/jshpos?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&nullCatalogMeansCurrent=true
JSH_POS_MYSQL_USERNAME=replace-in-secret-system
JSH_POS_MYSQL_PASSWORD=replace-in-secret-system
JSH_POS_REDIS_HOST=127.0.0.1
JSH_POS_REDIS_PORT=6379
JSH_POS_REDIS_PASSWORD=replace-in-secret-system
JSH_POS_LOG_FILE=./logs/jshpos-internal-rc.log
