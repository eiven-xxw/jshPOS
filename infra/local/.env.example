# 复制为 .env.runtime.local，或运行 scripts/local/New-LocalEnvironment.ps1 自动生成。
# 只允许本机调试；所有 replace-* 必须替换，文件不得提交。
MYSQL_ROOT_PASSWORD=replace-local-root-password
MYSQL_DATABASE=jshpos
MYSQL_USER=jshpos
MYSQL_PASSWORD=replace-local-app-password
MYSQL_PORT=3306
REDIS_PASSWORD=replace-local-redis-password
REDIS_PORT=6379
JSH_LOCAL_JWT_SECRET=replace-local-jwt-secret
JSH_LOCAL_ACTUATOR_USERNAME=local-ops
JSH_LOCAL_ACTUATOR_PASSWORD=replace-local-actuator-password
JSH_MEMBER_LOOKUP_KEY_B64=replace-local-base64-32-bytes
JSH_MEMBER_ENCRYPTION_KEY_B64=replace-local-base64-32-bytes
JSH_MEMBER_KEY_VERSION=1
JSH_REPORT_DOWNLOAD_HMAC_KEY_B64=replace-local-base64-32-bytes
JSH_REPORT_CURSOR_HMAC_KEY_B64=replace-local-base64-32-bytes
JSH_REPORT_INVENTORY_CURSOR_HMAC_KEY_B64=replace-local-base64-32-bytes
JSH_LOCAL_PACKAGE_SIGNING_KEY_ID=LOCAL_DEV_1
JSH_LOCAL_PACKAGE_SIGNING_PKCS8_B64=replace-local-ed25519-pkcs8
JSH_LOCAL_PACKAGE_SIGNING_PUBLIC_B64=replace-local-ed25519-raw-public
