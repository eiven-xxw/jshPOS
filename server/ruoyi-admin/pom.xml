        <dependency>
            <groupId>com.jingshanghui.pos</groupId>
            <artifactId>jshpos-promotion</artifactId>
        </dependency>

        <!-- Gate 5B 原单退货退款跨Owner可恢复Saga -->
        <dependency>
            <groupId>com.jingshanghui.pos</groupId>
            <artifactId>jshpos-returns</artifactId>
        </dependency>

        <!-- Gate 5C 会员身份、隐私与权益账本模块 -->
        <dependency>
            <groupId>com.jingshanghui.pos</groupId>
            <artifactId>jshpos-member</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jingshanghui.pos</groupId>
