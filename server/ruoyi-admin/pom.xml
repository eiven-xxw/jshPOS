        <dependency>
            <groupId>com.jingshanghui.pos</groupId>
            <artifactId>jshpos-reporting</artifactId>
        </dependency>

        <!-- Gate 7D 门店业务日日结、差异、审批与签署模块 -->
          <dependency>
              <groupId>com.jingshanghui.pos</groupId>
              <artifactId>jshpos-operations</artifactId>
          </dependency>
          <!-- Gate 8A 商户开户、套餐权益与租户商业生命周期 -->
          <dependency>
              <groupId>com.jingshanghui.pos</groupId>
              <artifactId>jshpos-saas</artifactId>
          </dependency>
          <!-- Gate 8A 订阅续期、宽限、受控降级和恢复 -->
          <dependency>
              <groupId>com.jingshanghui.pos</groupId>
              <artifactId>jshpos-subscription</artifactId>
          </dependency>
          <!-- Gate 8A 服务目录、实施项目、工单与附件治理 -->
          <dependency>
              <groupId>com.jingshanghui.pos</groupId>
              <artifactId>jshpos-service</artifactId>
          </dependency>

