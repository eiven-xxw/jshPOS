{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jshpos.local/connectors/manifest.schema.json",
  "title": "JshPosConnectorManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector_id", "name", "version", "contract_version", "capabilities"],
  "properties": {
    "connector_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["product", "inventory", "order", "refund", "reconciliation", "fulfillment"]
      }
    }
  }
}
