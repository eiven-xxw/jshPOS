{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jshpos:t2:gate6a:backup-manifest:v1",
  "title": "T2-BAK-001 canonical encrypted backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["backupId", "environment", "tenantIds", "tenantScopeSha256", "pointInTime", "schemaVersion", "applicationVersion", "keyVersion", "immutableUntil", "objects"],
  "properties": {
    "backupId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "environment": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "tenantIds": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,19}$"}},
    "tenantScopeSha256": {"$ref": "#/$defs/sha256"},
    "pointInTime": {"type": "string", "format": "date-time"},
    "schemaVersion": {"type": "string", "maxLength": 64},
    "applicationVersion": {"type": "string", "maxLength": 64},
    "keyVersion": {"type": "string", "maxLength": 64},
    "immutableUntil": {"type": "string", "format": "date-time"},
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dataClass", "logicalName", "mediaType", "plaintextSizeBytes", "plaintextSha256", "ciphertextSizeBytes", "ciphertextSha256", "keyVersion", "nonceBase64", "objectKey"],
        "properties": {
          "dataClass": {"enum": ["MYSQL", "BUSINESS_OBJECT", "CONFIG", "TEMPLATE", "MIGRATION", "EVIDENCE"]},
          "logicalName": {"type": "string", "maxLength": 256},
          "mediaType": {"type": "string", "maxLength": 64},
          "plaintextSizeBytes": {"type": "integer", "minimum": 1},
          "plaintextSha256": {"$ref": "#/$defs/sha256"},
          "ciphertextSizeBytes": {"type": "integer", "minimum": 29},
          "ciphertextSha256": {"$ref": "#/$defs/sha256"},
          "keyVersion": {"type": "string", "maxLength": 64},
          "nonceBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{16}$"},
          "objectKey": {"type": "string", "pattern": "^backups/[a-f0-9]{64}/[0-9A-HJKMNP-TV-Z]{26}/[a-f0-9]{64}\\.aead$"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "x-encryption": {"algorithm": "AES-256-GCM", "keyMaterialInManifest": false, "keySeparated": true},
  "x-runtime-status": "IN_PROGRESS",
  "x-external-cloud-evidence": "BLOCKED"
}
