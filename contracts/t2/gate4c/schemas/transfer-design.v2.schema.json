{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/inventory/transfer-design.v2.schema.json",
  "title": "Gate 4C transfer design-only envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transferId", "sourceWarehouseId", "destinationWarehouseId", "state", "lines"],
  "properties": {
    "schemaVersion": {"const": "2.0-design-only"},
    "transferId": {"type": "string"},
    "sourceWarehouseId": {"type": "string"},
    "destinationWarehouseId": {"type": "string"},
    "state": {"enum": ["DRAFT", "SUBMITTED", "APPROVED", "DISPATCHED", "IN_TRANSIT", "PARTIALLY_RECEIVED", "RECEIVED", "DIFFERENCE_PENDING", "CLOSED", "CANCELLED"]},
    "lines": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "x-invariants": [
    "sourceWarehouseId != destinationWarehouseId",
    "dispatch and receipt are independent idempotent inventory facts",
    "destination cost inherits dispatch cost snapshot",
    "cancel after dispatch requires an explicit reverse flow"
  ],
  "x-runtime-allowed": false,
  "x-requirement-id": "T2-TRF-001"
}

