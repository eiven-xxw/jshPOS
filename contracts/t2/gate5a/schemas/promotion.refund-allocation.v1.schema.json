{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/gate5a/promotion.refund-allocation.v1.schema.json",
  "title": "按原成交快照的退款优惠恢复",
  "type": "object",
  "additionalProperties": false,
  "required": ["refundId", "snapshotId", "refundableAmountMinor", "recoveredDiscountMinor", "lines", "resultHash"],
  "properties": {
    "refundId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "snapshotId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "refundableAmountMinor": {"type": "integer", "minimum": 0},
    "recoveredDiscountMinor": {"type": "integer", "minimum": 0},
    "lines": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["lineId", "quantity", "refundableAmountMinor", "recoveredDiscountMinor", "cumulativeQuantity", "cumulativeRefundableAmountMinor"], "properties": {"lineId": {"type": "string"}, "quantity": {"type": "string"}, "refundableAmountMinor": {"type": "integer", "minimum": 0}, "recoveredDiscountMinor": {"type": "integer", "minimum": 0}, "cumulativeQuantity": {"type": "string"}, "cumulativeRefundableAmountMinor": {"type": "integer", "minimum": 0}}}},
    "resultHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
