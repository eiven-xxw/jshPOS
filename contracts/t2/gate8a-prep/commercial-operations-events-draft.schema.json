{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jshpos.example/contracts/t2/gate8a-prep/commercial-operations-events-draft.schema.json",
  "title":"Gate 8A commercial SaaS operations event draft",
  "xContractStatus":"DRAFT_NON_EXECUTABLE",
  "type":"object",
  "additionalProperties":false,
  "required":["eventId","eventType","schemaVersion","authorityContext","aggregateId","aggregateVersion","occurredAt","payloadSha256","correlationId","payload"],
  "properties":{
    "eventId":{"type":"string","minLength":16,"maxLength":64},
    "eventType":{"enum":[
      "saas.merchant-application.state-changed.v1",
      "saas.entitlement-version.published.v1",
      "saas.tenant-lifecycle.changed.v1",
      "subscription.state-changed.v1",
      "subscription.notification-intent.created.v1",
      "service.implementation-project.state-changed.v1",
      "service.work-order.state-changed.v1",
      "service.attachment-reference.registered.v1"
    ]},
    "schemaVersion":{"const":"1.0-draft"},
    "authorityContext":{
      "type":"object",
      "additionalProperties":false,
      "required":["contextKind","authoritySource"],
      "properties":{
        "contextKind":{"enum":["PRE_TENANT_APPLICATION","TRUSTED_TENANT"]},
        "authoritySource":{"enum":["PLATFORM_SESSION","SERVER_JOB","APPROVED_INTERNAL_EVENT"]},
        "tenantId":{"type":"string","pattern":"^[0-9]{1,20}$"},
        "applicationId":{"type":"string","maxLength":26},
        "organizationId":{"type":"string","maxLength":26},
        "storeId":{"type":"string","maxLength":26}
      },
      "oneOf":[
        {"required":["applicationId"],"properties":{"contextKind":{"const":"PRE_TENANT_APPLICATION"}}},
        {"required":["tenantId"],"properties":{"contextKind":{"const":"TRUSTED_TENANT"}}}
      ]
    },
    "aggregateId":{"type":"string","minLength":1,"maxLength":64},
    "aggregateVersion":{"type":"integer","minimum":1},
    "occurredAt":{"type":"string","format":"date-time"},
    "payloadSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "correlationId":{"type":"string","minLength":8,"maxLength":64},
    "causationId":{"type":"string","maxLength":64},
    "payload":{
      "type":"object",
      "additionalProperties":false,
      "required":["owner","state","contentSha256"],
      "properties":{
        "owner":{"enum":["SAAS","SUBSCRIPTION","SERVICE"]},
        "state":{"type":"string","maxLength":64},
        "previousState":{"type":"string","maxLength":64},
        "planVersionRef":{"type":"string","maxLength":64},
        "entitlementVersionRef":{"type":"string","maxLength":64},
        "subscriptionRef":{"type":"string","maxLength":64},
        "workOrderRef":{"type":"string","maxLength":64},
        "effectiveAt":{"type":"string","format":"date-time"},
        "expiresAt":{"type":"string","format":"date-time"},
        "reasonCode":{"type":"string","maxLength":64},
        "contentSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
