{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jshpos.invalid/t2/gate1/data-package-manifest.v1.schema.json",
  "title": "Gate 1 Product Price Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "storeId", "packageVersion", "schemaVersion", "mode", "createdAt", "contentSha256", "signature", "chunks"],
  "properties": {
    "packageId": { "type": "string", "format": "uuid" },
    "storeId": { "type": "integer", "minimum": 1 },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "basePackageVersion": { "type": ["integer", "null"], "minimum": 1 },
    "schemaVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
    "mode": { "enum": ["FULL", "DELTA"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "minLength": 32, "maxLength": 256 },
    "chunks": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "sizeBytes", "sha256"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
