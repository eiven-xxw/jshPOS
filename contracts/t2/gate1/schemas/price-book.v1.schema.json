{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jshpos.invalid/t2/gate1/price-book.v1.schema.json",
  "title": "Gate 1 Price Book v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["priceBookId", "scopeType", "currency", "state", "effectiveFrom", "items", "version"],
  "properties": {
    "priceBookId": { "type": "integer", "minimum": 1 },
    "scopeType": { "enum": ["TENANT_BASE", "STORE"] },
    "storeId": { "type": ["integer", "null"], "minimum": 1 },
    "currency": { "const": "CNY" },
    "state": { "enum": ["DRAFT", "APPROVED", "PUBLISHED", "RETIRED"] },
    "effectiveFrom": { "type": "string", "format": "date-time" },
    "effectiveUntil": { "type": ["string", "null"], "format": "date-time" },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skuId", "unitId", "amountMinor"],
        "properties": {
          "skuId": { "type": "integer", "minimum": 1 },
          "unitId": { "type": "integer", "minimum": 1 },
          "amountMinor": { "type": "integer", "minimum": 0, "maximum": 999999999 }
        }
      }
    },
    "version": { "type": "integer", "minimum": 0 }
  }
}
