{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jshpos.invalid/t2/gate1/events/price-book.published.v1.schema.json",
  "title": "Gate 1 Draft Price Book Published Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "aggregateId", "aggregateVersion", "correlationId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "price-book.published.v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "integer", "minimum": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["priceBookId", "scopeType", "effectiveFrom", "contentSha256"],
      "properties": {
        "priceBookId": { "type": "integer", "minimum": 1 },
        "scopeType": { "enum": ["TENANT_BASE", "STORE"] },
        "storeId": { "type": ["integer", "null"], "minimum": 1 },
        "effectiveFrom": { "type": "string", "format": "date-time" },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
