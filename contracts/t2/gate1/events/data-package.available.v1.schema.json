{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jshpos.invalid/t2/gate1/events/data-package.available.v1.schema.json",
  "title": "Gate 1 Draft Data Package Available Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "aggregateId", "aggregateVersion", "correlationId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "data-package.available.v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 64 },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["packageId", "storeId", "packageVersion", "schemaVersion", "manifestSha256"],
      "properties": {
        "packageId": { "type": "string", "format": "uuid" },
        "storeId": { "type": "integer", "minimum": 1 },
        "packageVersion": { "type": "integer", "minimum": 1 },
        "schemaVersion": { "type": "string" },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
