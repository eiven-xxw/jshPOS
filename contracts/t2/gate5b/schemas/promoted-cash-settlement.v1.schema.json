{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jingshanghui.example/contracts/gate5b/promoted-cash-settlement.v1.schema.json",
  "title": "促销现金成交命令",
  "type": "object",
  "required": ["schemaVersion", "commandId", "idempotencyKey", "orderId", "quoteId", "quoteFingerprint", "packageVersion", "promotionSnapshotId", "grossMinor", "discountMinor", "surchargeMinor", "receivableMinor", "cashTenderedMinor", "lines"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "commandId": {"type": "string", "minLength": 26, "maxLength": 26},
    "idempotencyKey": {"type": "string", "minLength": 16, "maxLength": 128},
    "orderId": {"type": "string", "minLength": 26, "maxLength": 26},
    "quoteId": {"type": "string", "minLength": 26, "maxLength": 26},
    "quoteFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packageVersion": {"type": "integer", "minimum": 1},
    "promotionSnapshotId": {"type": "string", "minLength": 26, "maxLength": 26},
    "grossMinor": {"type": "integer", "minimum": 0},
    "discountMinor": {"type": "integer", "minimum": 0},
    "surchargeMinor": {"type": "integer", "minimum": 0},
    "receivableMinor": {"type": "integer", "minimum": 0},
    "cashTenderedMinor": {"type": "integer", "minimum": 0},
    "lines": {"type": "array", "minItems": 1, "maxItems": 500}
  },
  "additionalProperties": false
}
