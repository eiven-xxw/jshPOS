{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jingshanghui.example/contracts/gate5b/order.submitted.v2.schema.json",
  "title": "POS含促销快照订单提交事件",
  "type": "object",
  "required": ["schemaVersion", "orderId", "localOrderNo", "storeId", "terminalId", "cashierId", "shiftId", "businessDate", "storeTimezone", "catalogVersion", "priceVersion", "industryTemplateVersion", "promotionSnapshotId", "quoteId", "promotionEngineVersion", "promotionSnapshotHash", "quoteFingerprint", "settlementFingerprint", "packageVersion", "orderSnapshotHash", "manualEventRefs", "grossAmountMinor", "discountAmountMinor", "surchargeAmountMinor", "receivableAmountMinor", "tenderedAmountMinor", "lines"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "orderId": {"$ref": "#/$defs/ulid"},
    "printJobId": {"$ref": "#/$defs/ulid", "description": "POS本地成交事务冻结的原始打印任务身份；兼容旧v2事件时可缺省"},
    "localOrderNo": {"type": "string", "minLength": 1, "maxLength": 40},
    "storeId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "terminalId": {"$ref": "#/$defs/ulid"},
    "cashierId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "shiftId": {"$ref": "#/$defs/ulid"},
    "businessDate": {"type": "string", "format": "date"},
    "storeTimezone": {"type": "string", "minLength": 1, "maxLength": 64},
    "catalogVersion": {"type": "integer", "minimum": 1},
    "priceVersion": {"type": "integer", "minimum": 1},
    "industryTemplateVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "promotionSnapshotId": {"$ref": "#/$defs/ulid"},
    "quoteId": {"$ref": "#/$defs/ulid"},
    "promotionEngineVersion": {"type": "string", "const": "promotion-engine-1.0.0"},
    "promotionSnapshotHash": {"$ref": "#/$defs/prefixedHash"},
    "quoteFingerprint": {"$ref": "#/$defs/hash"},
    "settlementFingerprint": {"$ref": "#/$defs/hash"},
    "packageVersion": {"type": "integer", "minimum": 1},
    "orderSnapshotHash": {"$ref": "#/$defs/prefixedHash"},
    "manualEventRefs": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/ulid"}},
    "grossAmountMinor": {"type": "integer", "minimum": 0},
    "discountAmountMinor": {"type": "integer", "minimum": 0},
    "surchargeAmountMinor": {"type": "integer", "minimum": 0},
    "receivableAmountMinor": {"type": "integer", "minimum": 0},
    "tenderedAmountMinor": {"type": "integer", "minimum": 0},
    "lines": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/line"}}
  },
  "additionalProperties": false,
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prefixedHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "line": {
      "type": "object",
      "required": ["lineId", "lineNo", "skuId", "skuCode", "productName", "unitId", "unitCode", "quantity", "unitPriceMinor", "grossAmountMinor", "discountAmountMinor", "surchargeAmountMinor", "payableAmountMinor", "priceSource", "sourceAllocations"],
      "properties": {
        "lineId": {"$ref": "#/$defs/ulid"},
        "lineNo": {"type": "integer", "minimum": 1},
        "skuId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "skuCode": {"type": "string", "minLength": 1, "maxLength": 64},
        "barcode": {"type": ["string", "null"], "maxLength": 64},
        "productName": {"type": "string", "minLength": 1, "maxLength": 200},
        "unitId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "unitCode": {"type": "string", "minLength": 1, "maxLength": 32},
        "quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
        "unitPriceMinor": {"type": "integer", "minimum": 0},
        "grossAmountMinor": {"type": "integer", "minimum": 0},
        "discountAmountMinor": {"type": "integer", "minimum": 0},
        "surchargeAmountMinor": {"type": "integer", "minimum": 0},
        "payableAmountMinor": {"type": "integer", "minimum": 0},
        "priceSource": {"type": "string", "minLength": 1, "maxLength": 32},
        "sourceAllocations": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "measuredBarcodeSnapshot": {"$ref": "#/$defs/measuredBarcodeSnapshot"}
      },
      "additionalProperties": false
    },
    "measuredBarcodeSnapshot": {
      "type": "object",
      "required": ["rawBarcode", "skuCode", "encodedValue", "quantity", "amountMinor", "unitPriceMinor", "currency", "templateId", "templateVersion", "templateSha256", "parseSha256", "roundingApplied", "occurredAt"],
      "properties": {
        "rawBarcode": {"type": "string", "pattern": "^[0-9]{13}$"},
        "skuCode": {"type": "string", "pattern": "^[0-9]+$"},
        "encodedValue": {"type": "string", "pattern": "^[0-9]+$"},
        "quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$|^0\\.[0-9]*[1-9][0-9]*$"},
        "amountMinor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "unitPriceMinor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "currency": {"const": "CNY"},
        "templateId": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
        "templateVersion": {"type": "integer", "minimum": 1},
        "templateSha256": {"$ref": "#/$defs/hash"},
        "parseSha256": {"$ref": "#/$defs/hash"},
        "roundingApplied": {"type": "boolean"},
        "occurredAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
