{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jingshanghui.example/contracts/gate5b/order.completed.v2.schema.json",
  "title": "含促销快照的订单完成事件",
  "type": "object",
  "required": ["schemaVersion", "orderId", "shiftId", "paymentId", "businessDate", "currency", "grossAmountMinor", "discountAmountMinor", "surchargeAmountMinor", "receivableAmountMinor", "promotionSnapshotId", "promotionSnapshotHash", "quoteFingerprint", "settlementFingerprint", "packageVersion", "aggregateVersion", "orderSnapshotHash"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "orderId": {"type": "string", "minLength": 26, "maxLength": 26},
    "shiftId": {"type": "string", "minLength": 26, "maxLength": 26},
    "paymentId": {"type": "string", "minLength": 26, "maxLength": 26},
    "businessDate": {"type": "string", "format": "date"},
    "currency": {"const": "CNY"},
    "grossAmountMinor": {"type": "integer", "minimum": 0},
    "discountAmountMinor": {"type": "integer", "minimum": 0},
    "surchargeAmountMinor": {"type": "integer", "minimum": 0},
    "receivableAmountMinor": {"type": "integer", "minimum": 0},
    "promotionSnapshotId": {"type": "string", "minLength": 26, "maxLength": 26},
    "promotionSnapshotHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "quoteFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "settlementFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "packageVersion": {"type": "integer", "minimum": 1},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "orderSnapshotHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
