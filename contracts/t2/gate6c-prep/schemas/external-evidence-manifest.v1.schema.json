{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jshpos.example/contracts/t2/gate6c-prep/external-evidence-manifest.v1.schema.json",
  "title": "Gate 6C external evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceId", "requirementId", "track", "evidenceType", "sourceOrganization", "title", "version", "obtainedAt", "authorizationScope", "classification", "custodian", "controlledLocationReference", "sha256", "verificationStatus", "expiresAt", "auditReference"],
  "properties": {
    "evidenceId": {"type": "string", "pattern": "^G6C-EV-[A-Z0-9-]{4,64}$"},
    "requirementId": {"enum": ["T2-PAY-002", "T2-HWD-001", "T2-PAR-001"]},
    "track": {"enum": ["PAYMENT_SANDBOX", "REAL_DEVICE", "DESIGN_PARTNER"]},
    "evidenceType": {"type": "string", "minLength": 3, "maxLength": 80},
    "sourceOrganization": {"type": "string", "minLength": 2, "maxLength": 160},
    "title": {"type": "string", "minLength": 2, "maxLength": 240},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "obtainedAt": {"type": "string", "format": "date-time"},
    "authorizationScope": {"type": "string", "minLength": 4, "maxLength": 1000},
    "applicableReference": {"type": "string", "maxLength": 240},
    "classification": {"enum": ["INTERNAL", "CONFIDENTIAL", "RESTRICTED_SECRET", "RESTRICTED_PII"]},
    "custodian": {"type": "string", "minLength": 2, "maxLength": 120},
    "controlledLocationReference": {"type": "string", "pattern": "^(vault|dms|crm|evidence)://[A-Za-z0-9._/-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verificationStatus": {"enum": ["RECEIVED_UNVERIFIED", "VERIFIED_DOCUMENT", "REJECTED", "REVOKED", "EXPIRED"]},
    "verifiedBy": {"type": "array", "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
    "expiresAt": {"type": "string", "format": "date-time"},
    "deletionOrRevocationRule": {"type": "string", "maxLength": 500},
    "auditReference": {"type": "string", "minLength": 3, "maxLength": 240}
  }
}
