{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jingshanghui.example/contracts/t2/gate5d/internal-synthetic-bill-entry.v1.schema.json",
  "title": "Gate 5D Internal Synthetic Bill Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["billEntryId", "batchId", "sourceType", "synthetic", "schemaVersion", "contentSha256", "businessDate", "orgId", "storeId", "terminalId", "factType", "reconciliationKey", "amountMinor", "currency", "lifecycleStatus", "correlationId"],
  "properties": {
    "billEntryId": { "$ref": "#/$defs/ulid" },
    "batchId": { "$ref": "#/$defs/ulid" },
    "sourceType": { "const": "INTERNAL_SYNTHETIC" },
    "synthetic": { "const": true },
    "schemaVersion": { "const": "1.0" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "businessDate": { "type": "string", "format": "date" },
    "orgId": { "type": "integer", "minimum": 1 },
    "storeId": { "type": "integer", "minimum": 1 },
    "terminalId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "factType": { "enum": ["PAYMENT", "REFUND"] },
    "reconciliationKey": { "$ref": "#/$defs/ulid" },
    "amountMinor": { "type": "integer", "minimum": 0, "maximum": 9000000000000000000 },
    "currency": { "const": "CNY" },
    "lifecycleStatus": { "enum": ["SUCCEEDED", "FAILED", "UNKNOWN"] },
    "correlationId": { "$ref": "#/$defs/ulid" }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
