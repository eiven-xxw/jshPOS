{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/inventory/stocktake-posted.v1.schema.json",
  "title": "inventory.stocktake.posted.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "stocktakeId", "warehouseId", "lineCount", "varianceLineCount", "correlationId"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "stocktakeId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "warehouseId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "lineCount": {"type": "integer", "minimum": 1, "maximum": 500},
    "varianceLineCount": {"type": "integer", "minimum": 0, "maximum": 500},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 96}
  },
  "x-requirement-id": "T2-INV-003"
}
