{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/procurement/purchase-receipt-confirmed.v1.schema.json",
  "title": "procurement.receipt.confirmed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "receiptId", "purchaseOrderId", "storeId", "warehouseId", "lineCount", "correlationId"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "receiptId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "purchaseOrderId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "storeId": {"type": "integer", "minimum": 1},
    "warehouseId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "lineCount": {"type": "integer", "minimum": 1, "maximum": 500},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 96}
  },
  "x-requirement-id": "T2-PUR-001"
}
