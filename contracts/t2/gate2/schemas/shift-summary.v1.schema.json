{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/gate2/shift-summary.v1.schema.json",
  "title": "Gate 2 shift close summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "shiftId", "storeId", "terminalId", "cashierId", "businessDate", "currency", "openingCashMinor", "cashNetMinor", "theoreticalCashMinor", "actualCashMinor", "differenceMinor", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "shiftId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "storeId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "terminalId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "cashierId": {"type": "string", "minLength": 1, "maxLength": 64},
    "businessDate": {"type": "string", "format": "date"},
    "currency": {"const": "CNY"},
    "openingCashMinor": {"type": "integer", "minimum": 0},
    "cashNetMinor": {"type": "integer"},
    "theoreticalCashMinor": {"type": "integer"},
    "actualCashMinor": {"type": "integer", "minimum": 0},
    "differenceMinor": {"type": "integer"},
    "status": {"const": "CLOSED"},
    "approvalId": {"type": ["string", "null"], "maxLength": 64}
  }
}

