{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/gate2/events/order.submitted.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "shiftId", "receivableAmountMinor", "snapshotHash"],
  "properties": {
    "orderId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "shiftId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "receivableAmountMinor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "snapshotHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
