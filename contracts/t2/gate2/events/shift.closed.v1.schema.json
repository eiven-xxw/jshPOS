{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/gate2/events/shift.closed.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["shiftId", "businessDate", "currency", "theoreticalCashMinor", "actualCashMinor", "differenceMinor"],
  "properties": {
    "shiftId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "businessDate": {"type": "string", "format": "date"},
    "currency": {"const": "CNY"},
    "theoreticalCashMinor": {"type": "integer"},
    "actualCashMinor": {"type": "integer", "minimum": 0},
    "differenceMinor": {"type": "integer"},
    "approvalId": {"type": ["string", "null"], "maxLength": 64}
  }
}
