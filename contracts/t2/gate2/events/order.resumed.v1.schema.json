{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/gate2/events/order.resumed.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "storeId", "terminalId", "shiftId", "aggregateVersion"],
  "properties": {
    "orderId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "storeId": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "terminalId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "shiftId": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "aggregateVersion": {"type": "integer", "minimum": 3}
  }
}
