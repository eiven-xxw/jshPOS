{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/sprint3/sync-push-response.v1.schema.json",
  "title": "T2-SYN-001 per-event durable ACK",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "acks", "serverTime"],
  "properties": {
    "batchId": {"type": "string", "format": "uuid"},
    "acks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "payloadHash", "status"],
        "properties": {
          "eventId": {"type": "string", "format": "uuid"},
          "payloadHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {
            "type": "string",
            "enum": ["ACCEPTED", "ACCEPTED_PENDING", "DUPLICATE", "REJECTED_RETRYABLE", "REJECTED_FINAL", "CONFLICT", "DEVICE_BLOCKED"]
          },
          "resultCode": {"type": "string", "maxLength": 64},
          "retryAfterMs": {"type": "integer", "minimum": 0, "maximum": 86400000}
        }
      }
    },
    "serverTime": {"type": "string", "format": "date-time"}
  }
}
