{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jingshanghui.example/t2/sprint3/sync-ack-request.v1.schema.json",
  "title": "T2-SYN-001 atomic downstream cursor ACK",
  "type": "object",
  "additionalProperties": false,
  "required": ["stream", "cursor", "appliedChangeIds", "pageDigest"],
  "properties": {
    "stream": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 512},
    "appliedChangeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "pageDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
