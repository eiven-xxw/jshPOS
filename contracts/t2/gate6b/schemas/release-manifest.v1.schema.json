{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jshpos.example/contracts/gate6b/release-manifest.v1.schema.json",
  "title":"Gate 6B release manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["tenantId","artifactType","version","channel","objectKey","artifactSha256","keyVersion","buildCommit","sbomSha256","compatibility","storeIds"],
  "properties":{
    "tenantId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,19}$"},
    "artifactType":{"enum":["SERVER","WEB","MYSQL_SCHEMA","SQLITE_SCHEMA","TEMPLATE_PACKAGE","DATA_PACKAGE","APK"]},
    "version":{"type":"string","maxLength":64},
    "channel":{"enum":["INTERNAL","CANARY","STABLE","EMERGENCY"]},
    "objectKey":{"type":"string","maxLength":512},
    "artifactSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "keyVersion":{"type":"string","maxLength":64},
    "buildCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "sbomSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "compatibility":{"type":"object"},
    "storeIds":{"type":"array","minItems":1,"maxItems":10000,"uniqueItems":true,"items":{"type":"integer","minimum":1}}
  }
}
