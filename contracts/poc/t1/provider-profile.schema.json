{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsh.example/contracts/poc/t1/provider-profile.schema.json",
  "title": "T1 static payment provider profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerCode",
    "providerName",
    "publicDocs",
    "capabilities",
    "selectedForFake",
    "evidenceLevel",
    "integrationStatus",
    "sandboxStatus",
    "assumptions"
  ],
  "properties": {
    "providerCode": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "providerName": {"type": "string", "minLength": 2},
    "publicDocs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"enum": ["PUBLIC_DOC", "ASSUMPTION", "UNKNOWN"]}
    },
    "selectedForFake": {"type": "boolean"},
    "evidenceLevel": {"const": "STATIC"},
    "integrationStatus": {"const": "CANDIDATE_ONLY"},
    "sandboxStatus": {"const": "BLOCKED"},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
