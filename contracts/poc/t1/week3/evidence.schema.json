{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jshpos.example/contracts/poc/t1/week3/evidence.schema.json",
  "title": "T1 Week 3 STATIC/FAKE evidence",
  "type": "object",
  "required": ["schemaVersion", "phase", "scope", "evidenceLevel", "baselineTag", "commitSha", "results", "failedSeedSummary", "limitations"],
  "properties": {
    "schemaVersion": {"const": "3.0"},
    "phase": {"const": "T1-WEEK3"},
    "scope": {"const": "INTERNAL_SYNTHETIC_CROSS_FAULT_ONLY"},
    "evidenceLevel": {"enum": ["STATIC", "FAKE"]},
    "baselineTag": {"const": "t0-baseline-2026-08-16"},
    "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "results": {"type": "array", "minItems": 1},
    "failedSeedSummary": {
      "type": "object",
      "required": ["observed", "fixed", "untracked"],
      "properties": {
        "observed": {"type": "integer", "minimum": 0},
        "fixed": {"type": "integer", "minimum": 0},
        "untracked": {"const": 0}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 10}}
  },
  "additionalProperties": true
}
