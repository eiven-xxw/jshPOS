{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsh.example/contracts/poc/t1/fault-script.schema.json",
  "title": "T1 deterministic fake fault script",
  "type": "object",
  "additionalProperties": true,
  "required": ["fixtureVersion", "seed", "evidenceLevel", "domain", "scenarios"],
  "properties": {
    "fixtureVersion": {"const": "1.0"},
    "seed": {"type": "integer", "minimum": 1},
    "evidenceLevel": {"const": "FAKE"},
    "domain": {"enum": ["DEVICE", "PAYMENT", "OFFLINE", "SYNC", "TENANT"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fault", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "fault": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
